@* Readings exactly as the background worker processed them, newest first. The "#" is the
   processing order and the lane badge shows which queue each packet came through, so a
   critical packet jumping ahead of older FIFO packets is visible at a glance. *@
@implements IDisposable
@using SmartX.Client.Services
@using SmartX.Shared.Enums
@inject LiveStateContainer State

@{
    var readings = DeviceFilter.ApplyToFeed(State).Take(25).ToList();
}

<div class="feed">
    @if (readings.Count == 0)
    {
        <p class="muted">No readings yet. Start the simulator, or press "Simulate critical alert".</p>
    }
    else
    {
        <ul class="feed-list">
            @foreach (var reading in readings)
            {
                <li class="feed-item sev-@reading.Severity" @key="reading.ProcessedSequence">
                    <span class="feed-seq">#@reading.ProcessedSequence</span>
                    <span class="lane lane-@reading.Lane">@reading.Lane</span>
                    <span class="feed-device">@reading.DeviceName</span>
                    <span class="feed-value">@Format(reading)</span>
                    <span class="feed-time">@reading.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                </li>
            }
        </ul>
    }
</div>

<style>
    .feed-list { list-style: none; margin: 0; padding: 0; max-height: 420px; overflow-y: auto; }
    .feed-item { display: grid; grid-template-columns: 3.4rem 4.6rem 1fr auto 4.2rem; gap: 0.5rem; align-items: center; padding: 0.35rem 0.4rem; border-bottom: 1px solid #f0f1f3; font-size: 0.8rem; animation: feed-in 0.4s ease-out; }
    .feed-seq { font-family: ui-monospace, monospace; color: #9aa1ab; font-size: 0.72rem; }
    .lane { font-size: 0.66rem; font-weight: 700; text-transform: uppercase; padding: 0.1rem 0.4rem; border-radius: 4px; text-align: center; }
    .lane-FIFO { background: #eceef2; color: #4b5563; }
    .lane-Priority { background: #d1352b; color: #fff; }
    .feed-device { font-weight: 600; color: #1f2430; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .feed-value { font-variant-numeric: tabular-nums; white-space: nowrap; }
    .feed-time { color: #9aa1ab; font-size: 0.72rem; text-align: right; }
    .sev-Warning { background: #fffaf0; }
    .sev-Critical { background: #fdecea; }
    .muted { color: #9aa1ab; font-size: 0.85rem; }
    @@keyframes feed-in { from { background: #eef0ff; } }
    @@media (max-width: 640px) { .feed-item { grid-template-columns: 3rem 4.2rem 1fr auto; } .feed-time { display: none; } }
</style>

@code {
    protected override void OnInitialized() => State.Changed += OnStateChanged;

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    private static string Format(SmartX.Shared.Dtos.LiveReading reading) => reading.Kind switch
    {
        ReadingKind.ValveState => reading.Value >= 0.5 ? "open" : "closed",
        _ => $"{reading.Value:0.#} {reading.Unit}"
    };

    public void Dispose() => State.Changed -= OnStateChanged;
}
