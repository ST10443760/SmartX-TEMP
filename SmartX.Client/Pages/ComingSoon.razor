@page "/command-stream"
@page "/network-topology"

<PageTitle>Coming Soon - Smart-X Gateway</PageTitle>

<div class="coming-soon">
    <div class="lock-icon">🔒</div>
    <h1>@Title</h1>
    <p>@Description</p>
    <a class="btn-back" href="telemetry">← Back to Sensor Telemetry</a>
</div>

<style>
    .coming-soon {
        max-width: 560px;
        margin-top: 3rem;
        text-align: center;
    }

    .lock-icon {
        font-size: 2.5rem;
        margin-bottom: 1rem;
    }

    .coming-soon p {
        color: #5a6270;
        margin-bottom: 1.5rem;
    }

    .btn-back {
        display: inline-block;
        padding: 0.55rem 1.1rem;
        border-radius: 8px;
        background: #6a5acd;
        color: white;
        text-decoration: none;
        font-size: 0.9rem;
    }
</style>

@code {
    private string Title =>
        NavigationManager.Uri.Contains("command-stream")
            ? "Real-Time Command Stream & History"
            : "Network Topology & Mesh Routing";

    private string Description =>
        NavigationManager.Uri.Contains("command-stream")
            ? "This module - priority alert queues, manual override history, and the predictive action engine - ships in Part 2 of the Smart-X POE."
            : "This module - mesh graphing, traversal, and Minimum Spanning Tree routing - ships in the final Smart-X PoE submission.";

    [Inject]
    private Microsoft.AspNetCore.Components.NavigationManager NavigationManager { get; set; } = default!;
}
